<Project>
  <!-- The checks every build runs (.my/checks): the SDK's analyzers at their recommended level,
       code style from .editorconfig, and Meziantou's analyzers, less the
       rules Quality.globalconfig turns off with why. Imported by the root and src's
       Directory.Build.props; Frainet stands alone and keeps its own. -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Every package's known vulnerabilities, transitive ones too, fail the restore. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <!-- BRUINET010: Bruinet.Bdd's engine and runner protocol are public for Bruinet's own packages
         (Uat, the command line, Presenter, Workspace, Narrator) but not promised to consumers
         (public API review proposals 1 and 12). Bruinet's own libraries and tools use them knowingly; a test project
         or a sample is a consumer and opts in in its own project file (review 12, proposal 4). -->
    <NoWarn Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src')) or $(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)tools'))">$(NoWarn);BRUINET010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)Quality.globalconfig" />
  </ItemGroup>

  <!-- Items are evaluated after every property, so IsTestProject and TargetFrameworks set later count. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)Quality.Tests.globalconfig" />
  </ItemGroup>
  <!-- The UI suites (and their UAT suites) reach the app only through page objects and controls:
       BannedSymbols.UiTests.txt names what they may not call, RS0030 stops the build. -->
  <ItemGroup Condition="$(MSBuildProjectName.Contains('UITests')) or $(MSBuildProjectName.EndsWith('.Uat'))">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.UiTests.txt" />
  </ItemGroup>
  <!-- The library waits on conditions, never on a guess (AD-004; review 02, finding 13): BannedSymbols.Src.txt
       stops a Thread.Sleep or Task.Delay in src/, and src/.editorconfig lists the files whose pause is a poll's,
       a retry's or pacing. -->
  <ItemGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src')) and !$(MSBuildProjectName.Contains('UITests')) and !$(MSBuildProjectName.EndsWith('.Uat'))">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Src.txt" />
  </ItemGroup>
  <!-- Only Bruinet.Mocking.Data also targets netstandard2.0 beside .NET: on .NET the rules would ask for helpers its
       netstandard target lacks. A net48 or netstandard-only project has no such helper, so the rules find nothing there
       (review 12, proposal 1). -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Bruinet.Mocking.Data'">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)Quality.Legacy.globalconfig" />
  </ItemGroup>
</Project>
