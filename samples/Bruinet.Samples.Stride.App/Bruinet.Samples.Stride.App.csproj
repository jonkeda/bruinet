<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Bruinet.Samples.Stride.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Known advisories in Stride's own asset-build tools (MSBuild, NuGet, SSH.NET), pulled in by
       Stride.Engine; the sample app ships nowhere. Each one by name, so a new advisory still fails
       the restore (AD-033). -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-h4j7-5rxr-p4wc" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-g4vj-cjjj-v7hg" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-mggc-4xg6-vcxf" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-q939-rpr3-3284" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);AUTOMATION_ENABLED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stride.Engine" />
    <PackageReference Include="Stride.UI" />
    <PackageReference Include="Stride.Graphics" />
    <PackageReference Include="Stride.Rendering" />
    <PackageReference Include="Stride.CommunityToolkit.Windows" />
    <PackageReference Include="Stride.CommunityToolkit.Bepu" />
    <!-- Pinned past GHSA-2fmv-rv2c-59x7: Stride's toolkit brings 9.0.6 (Directory.Packages.props). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bruinet.Stride.Automation\Bruinet.Stride.Automation.csproj" />
  </ItemGroup>

  <!-- Stride's asset compiler reads Bruinet.Stride at its first target framework (net8.0), which this
       app's own build does not need: built here first, or the solution's parallel build races it (CI
       failed on "Unable to build assembly reference ...\net8.0\Bruinet.Stride.dll", 2026-11-01). -->
  <Target Name="BuildBruinetStrideForAssetCompiler" BeforeTargets="StrideCompileAsset">
    <MSBuild Projects="..\..\src\Bruinet.Stride\Bruinet.Stride.csproj" Targets="Build" Properties="TargetFramework=net8.0" />
  </Target>

</Project>
