<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="using:Bruinet.Samples.Maui.App.ViewModels"
    xmlns:uia="clr-namespace:Bruinet.Maui.AppSupport.Uia;assembly=Bruinet.Maui.AppSupport"
    x:Class="Bruinet.Samples.Maui.App.Views2.TestViews.ButtonsView"
    BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}">

    <ContentView.BindingContext>
        <viewModels:ButtonsViewModel />
    </ContentView.BindingContext>

    <ScrollView>
        <VerticalStackLayout 
            Padding="20" 
            Spacing="15"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}">

            <!-- Title -->
            <Label 
                Text="Buttons Module Test" 
                FontSize="24" 
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light=Black, Dark=White}" />

            <Label 
                Text="Test Button and ImageButton controls" 
                FontSize="14"
                TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

            <BoxView Color="{AppThemeBinding Light=LightGray, Dark=Gray}" HeightRequest="1" />

            <!-- Button Test -->
            <Label Text="Basic Button" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
            <Button 
                Text="Click Me" 
                Command="{Binding TestButtonCommand}"
                AutomationId="TestButton"
                BackgroundColor="#007AFF" />

            <!-- ImageButton Test -->
            <Label Text="Image Button" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
            <Button 
                Text="📷 Image Button" 
                Command="{Binding TestImageButtonCommand}"
                AutomationId="TestImageButton"
                BackgroundColor="#FF9500" />

            <BoxView Color="{AppThemeBinding Light=LightGray, Dark=Gray}" HeightRequest="1" />

            <!-- Status Display -->
            <Label Text="Status:" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
            <Label 
                Text="{Binding StatusMessage}" 
                AutomationId="StatusLabel"
                FontSize="13"
                LineBreakMode="WordWrap"
                TextColor="{AppThemeBinding Light=DarkGreen, Dark=LightGreen}"
                Padding="10"
                BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2F2F2F}" />

            <!-- The control contracts' controls (review 08, finding 2): one that records what happened to it, a hidden
                 and a disabled one, and a label with no text. -->
            <Button
                Text="Contract"
                Command="{Binding ContractClickCommand}"
                AutomationId="ContractButton"
                uia:GestureAutomation.Verbs="DoubleTap">
                <Button.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="2" Command="{Binding ContractDoubleTapCommand}" />
                </Button.GestureRecognizers>
            </Button>
            <Label Text="{Binding ContractAction}" AutomationId="ContractAction" />
            <Button Text="Hidden" AutomationId="HiddenButton" IsVisible="False" />
            <Button Text="Disabled" AutomationId="DisabledButton" IsEnabled="False" />
            <Label Text="Contract label" AutomationId="ContractLabel" />
            <Label Text="" AutomationId="EmptyLabel" />

            <!-- Reset Button -->
            <Button 
                Text="Reset" 
                Command="{Binding ResetCommand}"
                AutomationId="ResetButton"
                BackgroundColor="#A2845C" />

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
