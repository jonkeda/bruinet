<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0 is the app for the MauiHeadless head (docs/guides/maui-headless.md): its pages, views and
      view models as a library the test process loads, without Platforms\, MauiProgram or the packaged
      assets. Windows only on Windows, so the app restores on a Mac for that head.
    -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0;$(TargetFrameworks)</TargetFrameworks>
    <OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>
    <RootNamespace>Bruinet.Samples.Maui.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    
    <!-- Windows Package Type -->
    <WindowsPackageType>None</WindowsPackageType>
    
    <!-- Include Windows App SDK in output (no separate runtime install needed) -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Display name -->
    <ApplicationTitle>Bruinet MAUI Sample</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.bruinet.samples.maui</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Windows -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Mobile -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>

    <!--
      Embed the managed assemblies in the APK even in Debug.

      Android Debug builds default to Fast Deployment, which leaves the assemblies out of the
      APK for `dotnet run` to push separately. A UI test installs only the APK, so the app
      aborts at startup with "No assemblies found ... Assuming this is part of Fast
      Deployment" - a crash before any test code runs, reported by Appium only as "app never
      started".
    -->
    <EmbedAssembliesIntoApk Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="CommunityToolkit.Maui" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" />
  </ItemGroup>

  <!--
    The MauiDevFlow agent, for the DevFlow runner (src/Bruinet.Maui.DevFlow): only in a build with
    -p:BruinetDevFlow=true, so the FlaUI and Appium runs measure the app without it. Not in the
    net10.0 (MauiHeadless) target, which has no MauiProgram.
  -->
  <PropertyGroup Condition="'$(BruinetDevFlow)' == 'true' and '$(TargetFramework)' != 'net10.0'">
    <DefineConstants>$(DefineConstants);MAUI_DEVFLOW</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(BruinetDevFlow)' == 'true' and '$(TargetFramework)' != 'net10.0'">
    <PackageReference Include="Microsoft.Maui.DevFlow.Agent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinet.Samples.Shared\Bruinet.Samples.Shared.csproj" />
    <!--
      Demonstrates the "reference the project" route for the Bruinet automation
      handlers. The other supported route is copying AppSupport's sources into the
      app under test - see BruinetAutomationSupport for why both exist.
    -->
    <ProjectReference Include="..\Bruinet.Maui.AppSupport\Bruinet.Maui.AppSupport.csproj" />
  </ItemGroup>

  <!-- The MauiHeadless build: no platform code and no app builder; a test composes the app itself. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="MauiProgram.cs;Platforms\**" />
    <MauiXaml Remove="Platforms\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

    <!-- Images. Without this the app shipped no images at all, so the Image demo's
         Source="appicon.png" resolved to nothing: the control rendered at zero size and
         reported no bounding rectangle, which is why its visibility test could never pass. -->
    <MauiImage Include="Resources\Images\**" />

    <!-- Raw Assets -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\**" />
    <Compile Remove="Platforms\Windows\Controls\**" />
    <Compile Remove="TestViews\**" />
    <EmbeddedResource Remove="Models\**" />
    <EmbeddedResource Remove="Platforms\Windows\Controls\**" />
    <EmbeddedResource Remove="TestViews\**" />
    <MauiCss Remove="Models\**" />
    <MauiCss Remove="Platforms\Windows\Controls\**" />
    <MauiCss Remove="TestViews\**" />
    <MauiXaml Remove="Models\**" />
    <MauiXaml Remove="Platforms\Windows\Controls\**" />
    <MauiXaml Remove="TestViews\**" />
    <None Remove="Models\**" />
    <None Remove="Platforms\Windows\Controls\**" />
    <None Remove="TestViews\**" />
    <Page Remove="Platforms\Windows\Controls\**" />
  </ItemGroup>

