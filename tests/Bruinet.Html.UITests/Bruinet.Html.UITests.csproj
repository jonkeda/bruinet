<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinet.Html.UITests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bruinet.Core\Bruinet.Core.csproj" />
    <ProjectReference Include="..\..\src\Bruinet.Html\Bruinet.Html.csproj" />
    <ProjectReference Include="..\..\src\Bruinet.Html.Playwright\Bruinet.Html.Playwright.csproj" />
    <ProjectReference Include="..\..\src\Bruinet.Html.Bunit\Bruinet.Html.Bunit.csproj" />
  </ItemGroup>

  <!-- Built with the tests and started by them on the browser head (TestBase/BlazorSample); referenced for the bUnit head, which renders its Routes (TestBase/BlazorSampleBunit). -->
  <ItemGroup>
    <ProjectReference Include="..\..\samples\Bruinet.Samples.Blazor.App\Bruinet.Samples.Blazor.App.csproj" />
  </ItemGroup>

  <!-- The control contracts in Chromium (.my/coverage/plan.md, C3): their bindings, and the site that serves
       their pages, built with the tests and started by them (TestBase/ContractSite). -->
  <ItemGroup>
    <ProjectReference Include="..\Bruinet.ControlContracts.Html\Bruinet.ControlContracts.Html.csproj" />
    <ProjectReference Include="..\Bruinet.ControlContracts.Html.Site\Bruinet.ControlContracts.Html.Site.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The UAT suite: uat.config.md, Features/ and Uat/ (the fixture and the scenario test class). -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bruinet.Uat\Bruinet.Uat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="uat.config.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Features\**\*.feature.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestSettings\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bruinet.Bdd" />
  </ItemGroup>

</Project>
