<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinet.Stride.UITests</RootNamespace>
    <!-- The game it drives is a Windows app, and the UAT suite references it. -->
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bruinet.Core\Bruinet.Core.csproj" />
    <ProjectReference Include="..\..\src\Bruinet.Stride\Bruinet.Stride.csproj" />
    <ProjectReference Include="..\..\src\Bruinet.Stride.Automation\Bruinet.Stride.Automation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The UAT suite: bdd.config.md, Features/ and Uat/ (the fixture and the scenario test class). -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bruinet.Uat\Bruinet.Uat.csproj" />
    <ProjectReference Include="..\..\samples\Bruinet.Samples.Stride.App\Bruinet.Samples.Stride.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="bdd.config.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Features\**\*.feature.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestSettings\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildStrideSampleApp" BeforeTargets="Build">
    <MSBuild Projects="..\..\samples\Bruinet.Samples.Stride.App\Bruinet.Samples.Stride.App.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>

  <ItemGroup>
    <Using Include="Bruinet.Bdd" />
  </ItemGroup>

</Project>
