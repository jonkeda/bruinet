<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Uses Bruinet.Bdd's engine, which is experimental (BRUINET010, docs/experimental.md): opted in knowingly. -->
    <NoWarn>$(NoWarn);BRUINET010</NoWarn>
    <RootNamespace>Bruinet.Mocking.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moq" />
    <!-- The analyzer tests compile snippets against Bruinet.Mocking. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bruinet.Core\Bruinet.Core.csproj" />
    <ProjectReference Include="..\..\src\Bruinet.Mocking\Bruinet.Mocking.csproj" />
    <ProjectReference Include="..\..\src\Bruinet.Mocking.Analyzers\Bruinet.Mocking.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ContractSamples\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
