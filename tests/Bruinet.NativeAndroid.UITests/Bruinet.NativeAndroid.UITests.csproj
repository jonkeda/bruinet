<Project Sdk="Microsoft.NET.Sdk">

  <!-- Drives the native Android sample (samples/Bruinet.Samples.NativeAndroid.App) on an emulator
       through Appium, and holds the platform's UAT suite (AD-026). Needs a device, so it stays out
       of CI's unit test list. -->
  <PropertyGroup>
    <RootNamespace>Bruinet.NativeAndroid.UITests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bruinet.NativeAndroid\Bruinet.NativeAndroid.csproj" />
    <!-- The UAT suite: bdd.config.md, Features/ and Uat/ (the scenario test class). -->
    <ProjectReference Include="..\..\src\Bruinet.Uat\Bruinet.Uat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="bdd.config.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Features\**\*.feature.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
