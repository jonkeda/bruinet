<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Uses Bruinet.Bdd's engine, which is experimental (BRUINET010, docs/experimental.md): opted in knowingly. -->
    <NoWarn>$(NoWarn);BRUINET010</NoWarn>
    <RootNamespace>Bruinet.Cli.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\Bruinet.Cli\Bruinet.Cli.csproj" />
    <!-- scrape: the site the commands explore, served by TestSiteServer; its files come along. -->
    <ProjectReference Include="..\Bruinet.Scraper.TestSite\Bruinet.Scraper.TestSite.csproj" />
    <!-- The language server and MCP tests read the Todo sample's built suite: built first, never referenced, so it
         is never older than the Core and Bdd these tests run (R2-T114). -->
    <ProjectReference Include="..\..\samples\Todo\tests\Bruinet.Samples.Todo.Uat\Bruinet.Samples.Todo.Uat.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- controls generate: the inputs and expected outputs are files to read, not code; under TestData\ in the output. -->
    <Compile Remove="Generate/TestData/**/*.cs" />
    <Content Include="Generate/TestData/**/*" CopyToOutputDirectory="PreserveNewest" Link="TestData/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Bruinet.Bdd" />
    <Using Include="Bruinet.Uat" />
  </ItemGroup>

</Project>
