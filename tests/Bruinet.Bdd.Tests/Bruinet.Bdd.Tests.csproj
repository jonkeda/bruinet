<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Uses Bruinet.Bdd's engine, which is experimental (BRUINET010, docs/experimental.md): opted in knowingly. -->
    <NoWarn>$(NoWarn);BRUINET010</NoWarn>
    <RootNamespace>Bruinet.Bdd.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bruinet.Bdd\Bruinet.Bdd.csproj" />
    <!-- Property-based tests (AD-033). -->
    <PackageReference Include="CsCheck" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bruinet.Bdd" />
  </ItemGroup>

</Project>
