+++ b/samples/Bruinet.Samples.Maui.App/Pages/WebViewPage.xaml
@@ -0,0 +1,25 @@
+<?xml version="1.0" encoding="utf-8" ?>
+<!--
+    A WebView with app content after it. On Windows a UI Automation descendant search that reaches the
+    WebView2 leaves its scope: it answers elements from the rest of the window and never reaches what
+    follows the WebView2. "Marker" is both outside and inside the host, so a lookup that leaves the
+    host answers the wrong one.
+-->
+<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
+             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
+             x:Class="Bruinet.Samples.Maui.App.WebViewPage"
+             AutomationId="WebViewPage"
+             Title="WebView">
+    <VerticalStackLayout Padding="20" Spacing="12">
+        <Label AutomationId="Marker" Text="outside" />
+        <Grid AutomationId="WebViewHost" RowDefinitions="160,Auto">
+            <WebView AutomationId="Web">
+                <WebView.Source>
+                    <HtmlWebViewSource Html="&lt;p&gt;Web content&lt;/p&gt;" />
+                </WebView.Source>
+            </WebView>
+            <Label Grid.Row="1" AutomationId="Marker" Text="inside" />
+        </Grid>
+        <Label AutomationId="AfterWebView" Text="after" />
+    </VerticalStackLayout>
+</ContentPage>
