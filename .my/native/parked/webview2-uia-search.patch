+++ b/tests/Bruinet.Maui.UITests/Tests/Container/WebViewLookupTests.cs
@@ -0,0 +1,37 @@
+using Bruinet.Maui.UITests.Pages;
+
+namespace Bruinet.Maui.UITests.Tests.Container;
+
+/// <summary>
+/// Lookups past a WebView: on Windows a UI Automation descendant search that reaches the WebView2
+/// leaves its scope, so the lookup must still answer the element inside the scope and after the WebView.
+/// </summary>
+[Collection("Maui")]
+[Trait("Category", "UITest")]
+[Trait("Pattern", "Container")]
+public class WebViewLookupTests
+{
+    private readonly WebViewTestPage _page;
+
+    public WebViewLookupTests(MauiFixture fixture)
+    {
+        fixture.Open(SamplePage.WebView);
+        _page = new WebViewTestPage(fixture.Context);
+    }
+
+    [WindowsOnlyFact("it checks the Windows UI Automation search past a WebView2", Timeout = TestConstants.DefaultTestTimeoutMs)]
+    public Task ElementAfterAWebView_InItsContainer_IsTheContainersOwn()
+    {
+        _page.InsideMarker.AssertText("inside");
+
+        return Task.CompletedTask;
+    }
+
+    [WindowsOnlyFact("it checks the Windows UI Automation search past a WebView2", Timeout = TestConstants.DefaultTestTimeoutMs)]
+    public Task ElementAfterAWebView_OnThePage_IsFound()
+    {
+        _page.AfterWebView.AssertText("after");
+
+        return Task.CompletedTask;
+    }
+}
