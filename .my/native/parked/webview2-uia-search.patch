diff --git a/src/Bruinet.FlaUI/UiaElements.cs b/src/Bruinet.FlaUI/UiaElements.cs
index 12350a80..897c4052 100644
--- a/src/Bruinet.FlaUI/UiaElements.cs
+++ b/src/Bruinet.FlaUI/UiaElements.cs
@@ -109,7 +109,16 @@ public static class UiaElements
         ArgumentNullException.ThrowIfNull(app);
         ArgumentNullException.ThrowIfNull(within);
         ArgumentNullException.ThrowIfNull(locator);
-        return within.FindFirstDescendant(locator.ToCondition(app.ConditionFactory));
+        var condition = locator.ToCondition(app.ConditionFactory);
+        var found = within.FindFirstDescendant(condition);
+        if (found != null && IsUnder(app, found, within))
+        {
+            return found;
+        }
+
+        // A descendant search that reaches a WinUI WebView2 leaves the scope: it answers elements
+        // from the rest of the window and never reaches what follows the WebView2.
+        return HostsWebView(app, within) ? Walk(app, within, condition, firstOnly: true).FirstOrDefault() : null;
     }
 
     /// <summary>Every descendant of <paramref name="within"/> matching <paramref name="locator"/> now. One attempt.</summary>
@@ -121,6 +130,78 @@ public static class UiaElements
         ArgumentNullException.ThrowIfNull(app);
         ArgumentNullException.ThrowIfNull(within);
         ArgumentNullException.ThrowIfNull(locator);
-        return within.FindAllDescendants(locator.ToCondition(app.ConditionFactory));
+        var condition = locator.ToCondition(app.ConditionFactory);
+        return HostsWebView(app, within)
+            ? Walk(app, within, condition, firstOnly: false)
+            : within.FindAllDescendants(condition);
+    }
+
+    private static readonly string[] WebViewHostClassNames = ["Microsoft.UI.Xaml.Controls.WebView2"];
+
+    private static bool HostsWebView(DesktopApp app, AutomationElement within)
+    {
+        var factory = app.ConditionFactory;
+        var condition = new OrCondition(WebViewHostClassNames.Select(name => (ConditionBase)factory.ByClassName(name)).ToArray());
+        return within.FindFirstDescendant(condition) != null;
+    }
+
+    private static bool IsUnder(DesktopApp app, AutomationElement element, AutomationElement ancestor)
+    {
+        var walker = app.Automation.TreeWalkerFactory.GetControlViewWalker();
+        var node = walker.GetParent(element);
+        for (var depth = 0; node != null && depth < MaxAttachedDepth; depth++)
+        {
+            if (node.Equals(ancestor))
+            {
+                return true;
+            }
+
+            node = walker.GetParent(node);
+        }
+
+        return false;
+    }
+
+    // Child by child in document order, never into a WebView2: its content is web content,
+    // reached through the browser, not through a search of the app's tree.
+    private static List<AutomationElement> Walk(DesktopApp app, AutomationElement within, ConditionBase condition, bool firstOnly)
+    {
+        var found = new List<AutomationElement>();
+        var pending = new Stack<(AutomationElement Element, int Depth)>();
+        Push(within, 0);
+
+        while (pending.Count > 0)
+        {
+            var (element, depth) = pending.Pop();
+            if (element.FindFirst(global::FlaUI.Core.Definitions.TreeScope.Element, condition) != null)
+            {
+                found.Add(element);
+                if (firstOnly)
+                {
+                    break;
+                }
+            }
+
+            if (Array.IndexOf(WebViewHostClassNames, element.Properties.ClassName.ValueOrDefault) < 0)
+            {
+                Push(element, depth);
+            }
+        }
+
+        return found;
+
+        void Push(AutomationElement parent, int depth)
+        {
+            if (depth >= MaxAttachedDepth)
+            {
+                return;
+            }
+
+            var children = parent.FindAllChildren();
+            for (var index = children.Length - 1; index >= 0; index--)
+            {
+                pending.Push((children[index], depth + 1));
+            }
+        }
     }
 }
