@@ -0,0 +1,22 @@
+namespace Bruinet.Maui.UITests.Pages;
+
+/// <summary>A WebView with app content after it; "Marker" is both outside and inside the host.</summary>
+public class WebViewTestPage : PageObjectBase<WebViewTestPage>
+{
+    public WebViewTestPage(IMauiTestContext context)
+        : base(context)
+    {
+    }
+
+    /// <inheritdoc />
+    public override string Name => "WebViewPage";
+
+    /// <summary>The Grid holding the WebView and, after it, the inside "Marker".</summary>
+    public Grid<WebViewTestPage> Host => new(this, "WebViewHost");
+
+    /// <summary>"inside": the host's own marker, after the WebView.</summary>
+    public Label<Grid<WebViewTestPage>> InsideMarker => new(Host, "Marker");
+
+    /// <summary>"after": below the host, so after the WebView in the page.</summary>
+    public Label<WebViewTestPage> AfterWebView => new(this, "AfterWebView");
+}
