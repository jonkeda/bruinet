<Project Sdk="Microsoft.NET.Sdk">

  <!-- The BDD CodeLens on C# members (phase 4). Visual Studio runs CodeLens providers in its own
       CodeLens process, so this is an assembly of its own, carried in the VSIX as a
       CodeLensComponent. It holds no engine types: it asks the extension, which asks the server. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Bruinet.Bdd.VisualStudio.CodeLens</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" ExcludeAssets="runtime" />
    <!-- The SDK's transitive packages with advisories, pinned in Directory.Packages.props; Visual Studio
         carries its own at run time. -->
    <PackageReference Include="MessagePack" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.IO.Redist" ExcludeAssets="runtime" />
    <PackageReference Include="System.Text.Json" ExcludeAssets="runtime" />
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>

</Project>
