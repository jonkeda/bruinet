<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>bruinet</AssemblyName>
    <RootNamespace>Bruinet.Cli</RootNamespace>
    <Description>bruinet: Bruinet's one command line - the Scraper, test data and scenarios, control generation, and the language and MCP servers the IDEs and agents start.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bruinet</ToolCommandName>
    <PackageId>Bruinet.Cli</PackageId>
    <!-- Playwright's driver carries .ps1 files of its own; NuGet only warns that it will not run them. -->
    <NoWarn>$(NoWarn);NU5110;NU5111</NoWarn>
    <!-- One tool package per platform (.NET 10), each with only its own native files: SqlClient's and SQLite's,
         and Playwright's Node driver, which a build without a RID copies for the building machine only, so a
         package packed on Windows ran no Scraper on Linux or macOS (R2-T119). No portable `any` package: the SDK
         hands `any` to the referenced libraries as a platform, which they cannot restore. -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers>$(RuntimeIdentifiers)</ToolPackageRuntimeIdentifiers>
    <!-- A build for no platform (a local build, the VS Code server's publish) carries every platform's Node driver. -->
    <PlaywrightPlatform Condition="'$(RuntimeIdentifier)' == ''">all</PlaywrightPlatform>
    <!-- Playwright ships no Windows Arm64 driver; Windows on Arm runs the x64 one. -->
    <PlaywrightPlatform Condition="'$(RuntimeIdentifier)' == 'win-arm64'">win</PlaywrightPlatform>
    <!-- The top-level package only points at the platform packages: no files, so no symbols package (NU5017). -->
    <IncludeSymbols Condition="'$(RuntimeIdentifier)' == ''">false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bruinet.Bdd.Workspace\Bruinet.Bdd.Workspace.csproj" />
    <ProjectReference Include="..\..\src\Bruinet.Scraper\Bruinet.Scraper.csproj" />
    <!-- data: Bruinet.TestData is shared with the loaded assemblies, so their definitions are the tool's ITestDataDefinition. -->
    <ProjectReference Include="..\..\src\Bruinet.TestData\Bruinet.TestData.csproj" />
    <!-- Bruinet.Uat is an Exe, which the SDK would build per platform as the tool is: built once, for none (R2-T119). -->
    <ProjectReference Include="..\..\src\Bruinet.Uat\Bruinet.Uat.csproj" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    <!-- sql: the SQL log's schema snapshot, Extended Events and report (.my/sql-replay/plan.md, step 1). -->
    <ProjectReference Include="..\..\src\Bruinet.Mocking.Data\Bruinet.Mocking.Data.csproj" />
    <ProjectReference Include="..\..\src\Bruinet.Mocking.Http\Bruinet.Mocking.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
    <!-- Pinned past GHSA-qhrr-8q5h-9q3h: StreamJsonRpc brings 2.5.302 (Directory.Packages.props). -->
    <PackageReference Include="MessagePack" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- The schema snapshot of a SQLite file (sql schema, provider sqlite) -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- SqlClient brings 9.0.11, which has known vulnerabilities: lifted to the repository's pinned version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <!-- controls generate -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bruinet.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bruinet.Bdd" />
    <Using Include="Bruinet.Uat" />
  </ItemGroup>

  <!-- The recorder and voice for Record, which a net10.0-windows suite cannot reference (they need
       the Windows 10 SDK's projections): built here, and copied into recorders\ beside the server,
       which the recording run is pointed at (BRUINET_RECORDERS). -p:BruinetRecorders=false leaves them out, for a
       build that only selects or checks (Tomorrow's tools/Select-Tests.ps1, into its own artifacts folder). -->
  <ItemGroup Condition="'$(BruinetCarriesRecorders)' == 'true'">
    <ProjectReference Include="..\..\src\Bruinet.Narrator.Windows\Bruinet.Narrator.Windows.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net10.0-windows10.0.19041.0" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" Private="false" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Windows only, and not in another platform's tool package (R2-T119). -->
    <BruinetCarriesRecorders Condition="'$(OS)' == 'Windows_NT' And '$(BruinetRecorders)' != 'false' And ('$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win')))">true</BruinetCarriesRecorders>
  </PropertyGroup>

  <PropertyGroup>
    <RecordersOutput>..\..\src\Bruinet.Narrator.Windows\bin\$(Configuration)\net10.0-windows10.0.19041.0\</RecordersOutput>
  </PropertyGroup>

  <ItemGroup>
    <RecorderFile Include="$(RecordersOutput)Bruinet.Narrator.Windows.dll;$(RecordersOutput)Microsoft.Windows.SDK.NET.dll;$(RecordersOutput)WinRT.Runtime.dll" />
  </ItemGroup>

  <Target Name="CopyRecorders" AfterTargets="Build" Condition="'$(BruinetCarriesRecorders)' == 'true'">
    <Copy SourceFiles="@(RecorderFile)" DestinationFolder="$(OutDir)recorders" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishRecorders" AfterTargets="Publish" Condition="'$(BruinetCarriesRecorders)' == 'true'">
    <Copy SourceFiles="@(RecorderFile)" DestinationFolder="$(PublishDir)recorders" SkipUnchangedFiles="true" />
  </Target>

</Project>
