<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Recorder: a window with the site in a webview and one column of controls, for a site the walk may not
    press on (AD-027). A person clicks; the Scraper's engine records. Windows (WebView2) and Mac (WKWebView).
  -->
  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-maccatalyst</TargetFrameworks>
    <!-- -p:BruinetRecorderMac=true compiles the Mac's part on Windows too, as far as that goes without a Mac. -->
    <TargetFrameworks Condition="'$(BruinetRecorderMac)' == 'true'">net10.0-maccatalyst</TargetFrameworks>
    <!-- Elsewhere there is no webview to hold: the project restores and builds nothing that runs. -->
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0</TargetFrameworks>
    <OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>
    <RootNamespace>Bruinet.Recorder</RootNamespace>
    <AssemblyName>Bruinet.Recorder</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <IsPackable>false</IsPackable>
    <Description>The Recorder: a person clicks through a site in a webview and the Scraper records the pages and the presses.</Description>

    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationTitle>Bruinet Recorder</ApplicationTitle>
    <ApplicationId>com.bruinet.recorder</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="CommunityToolkit.Maui" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bruinet.Scraper\Bruinet.Scraper.csproj" />
  </ItemGroup>

</Project>
