<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Emit XML doc files so kept summaries reach IntelliSense/help. CS1591 (missing
         doc on a public member) is suppressed until the public surface has its summaries.
         CS1710 (duplicate typeparam) is suppressed because Bruinet.Generator copies the
         class-level doc onto the generated .gen.cs partial of every generic control, so both
         partials legitimately carry the same <typeparam>; the doc is authored once in .tpl.cs. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1710</NoWarn>

    <!-- On pack, the package's target frameworks agree with each other (AD-033); a baseline version
         is added with the first release. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    
    <!-- Versioning -->
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    
    <!-- Package metadata -->
    <Authors>Bruinet Contributors</Authors>
    <Company>Bruinet</Company>
    <Product>Bruinet UI Test Framework</Product>
    <Copyright>Copyright © 2024-$([System.DateTime]::Now.Year) Bruinet Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/exact-mobile-apps/test-tooling</PackageProjectUrl>
    <RepositoryUrl>https://github.com/exact-mobile-apps/test-tooling</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>bruinet;ui-testing;testing</PackageTags>
    <!-- Each package's README.md says what it is and what to name with it (review 11, proposal 6). -->
    <PackageReadmeFile Condition="Exists('$(MSBuildProjectDirectory)/README.md')">README.md</PackageReadmeFile>
    
    <!-- Source Link -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    
    <!-- Deterministic builds -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  
  <Import Project="$(MSBuildThisFileDirectory)../Quality.props" />

  <!-- A shipped package's public API is declared in PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt
       beside its project (AD-033); a change to it that the files do not show stops the build (RS0016, RS0017). -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false' and '$(OutputType)' != 'Exe' and '$(OutputType)' != 'WinExe'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt;$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt" />
    <!-- API only the .NET targets have, beside netstandard2.0 or .NET Framework. -->
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/PublicAPI/net/PublicAPI.Shipped.txt;$(MSBuildProjectDirectory)/PublicAPI/net/PublicAPI.Unshipped.txt" Condition="Exists('$(MSBuildProjectDirectory)/PublicAPI/net') and $(TargetFramework.StartsWith('net')) and !$(TargetFramework.StartsWith('netstandard')) and !$(TargetFramework.StartsWith('net4'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
