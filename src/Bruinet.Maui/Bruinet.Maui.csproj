<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageTags>$(PackageTags);maui;mobile;page-object</PackageTags>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bruinet.Maui</RootNamespace>
    <Description>MAUI UI testing automation. Provides controls, page objects, and driver factory for cross-platform MAUI application testing.</Description>
    <PackageId>Bruinet.Maui</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinet.Core\Bruinet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- [ScreenshotTest] derives from xUnit's BeforeAfterTestAttribute: declared, so a MAUI suite gets it (review 11, proposal 4). -->
    <PackageReference Include="xunit.extensibility.core" />
  </ItemGroup>

</Project>
