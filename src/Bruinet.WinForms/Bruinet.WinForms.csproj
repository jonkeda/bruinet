<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <RootNamespace>Bruinet.WinForms</RootNamespace>
    <Description>WinForms UI testing on the call model (AD-010), through UI Automation's patterns over Bruinet.FlaUI: generated controls with WinForms' names, pages, containers and collections, one call per member.</Description>
    <PackageId>Bruinet.WinForms</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinet.Core\Bruinet.Core.csproj" />
    <ProjectReference Include="..\Bruinet.FlaUI\Bruinet.FlaUI.csproj" />
  </ItemGroup>

</Project>
