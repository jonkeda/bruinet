<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <RootNamespace>Bruinet.FlaUI</RootNamespace>
    <Description>What the UI Automation stacks share over FlaUI (MAUI on Windows, WPF, WinForms): the desktop app session (launch, attach, the quiet foreground, window placement, screenshots), how a removed element is reported, the runtime id as an element's identity, one-attempt lookups and locators.</Description>
    <PackageId>Bruinet.FlaUI</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinet.Core\Bruinet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>

</Project>
