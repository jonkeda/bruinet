<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageTags>$(PackageTags);stride;games</PackageTags>
    <RootNamespace>Bruinet.Stride</RootNamespace>
    <Description>Stride game UI testing on the call model (AD-010): the client for Bruinet.Stride.Automation, with generated controls, pages, containers and collections, one call per member over the automation pipe.</Description>
    <PackageId>Bruinet.Stride</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bruinet.Stride.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinet.Stride.Protocol\Bruinet.Stride.Protocol.csproj" />
    <ProjectReference Include="..\Bruinet.Core\Bruinet.Core.csproj" />
  </ItemGroup>

</Project>
