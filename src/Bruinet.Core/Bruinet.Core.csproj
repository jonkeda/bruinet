<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bruinet.Core</RootNamespace>
    <Description>Platform-agnostic UI testing abstractions for .NET applications. Provides interfaces and base classes for building cross-platform UI test automation.</Description>
    <PackageId>Bruinet.Core</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="xunit.extensibility.core" PrivateAssets="all" />
  </ItemGroup>

  <!-- The step attributes Core's controls declare their built-in phrases with (proposal 7). -->
  <ItemGroup>
    <ProjectReference Include="..\Bruinet.Bdd.Abstractions\Bruinet.Bdd.Abstractions.csproj" />
  </ItemGroup>

</Project>
