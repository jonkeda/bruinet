<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageTags>$(PackageTags);wpf;desktop;flaui</PackageTags>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <RootNamespace>Bruinet.Wpf</RootNamespace>
    <Description>WPF UI testing on the call model (AD-010), through UI Automation's patterns over Bruinet.FlaUI: generated controls with WPF's names, pages, containers and collections, one call per member.</Description>
    <PackageId>Bruinet.Wpf</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinet.Core\Bruinet.Core.csproj" />
    <ProjectReference Include="..\Bruinet.FlaUI\Bruinet.FlaUI.csproj" />
  </ItemGroup>

</Project>
