<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageTags>$(PackageTags);mocking;wiremock;api</PackageTags>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>Bruinet.Api.Mocking</RootNamespace>
    <Description>API mocking infrastructure for UI tests. Provides WireMock-based mock servers for simulating backend services during testing.</Description>
    <PackageId>Bruinet.Api.Mocking</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bruinet.Core\Bruinet.Core.csproj" />
    <ProjectReference Include="..\Bruinet.Api.Contracts\Bruinet.Api.Contracts.csproj" />
    <ProjectReference Include="..\Bruinet.Api.OpenApi\Bruinet.Api.OpenApi.csproj" />
    <ProjectReference Include="..\Bruinet.Api.Replay\Bruinet.Api.Replay.csproj" />
    <!-- Steps/: the request steps a feature file opts into with Using MockRequests. -->
    <ProjectReference Include="..\Bruinet.Bdd\Bruinet.Bdd.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WireMock.Net" />
    <!-- Pinned past GHSA-6527-9fp8-r4x6; see Directory.Packages.props. -->
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
  </ItemGroup>

  <ItemGroup>
    <!-- BRUINET001 (AD-012) ships in the package as an analyzer, so every consumer gets it. -->
    <ProjectReference Include="..\Bruinet.Api.Mocking.Analyzers\Bruinet.Api.Mocking.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Bruinet.Api.Mocking.Analyzers\bin\$(Configuration)\netstandard2.0\Bruinet.Api.Mocking.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
