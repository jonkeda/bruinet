# The files under src/ that may sleep or delay (AD-004; review 02, finding 13). BannedSymbols.Src.txt stops a
# Thread.Sleep or Task.Delay anywhere else in src/: a wait waits on a condition, through a call's poll or Settle.
# Each file below is one of the kinds review 02 counted: a poll with a condition and a bound, a watcher, a retry,
# a timeout arm, or pacing, where the time is the product. A new one is added here with its kind.

# Polls: the pause between two looks, with a condition and a deadline.
[Bruinet.Core/Utilities/WaitHelper.cs]
dotnet_diagnostic.RS0030.severity = none
[Bruinet.Maui/Containers/CollectionObjectBase.cs]
dotnet_diagnostic.RS0030.severity = none
