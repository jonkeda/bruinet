<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage of Bruinet's libraries from the unit tests (AD-033), read by tools/Scripts/coverage.ps1.
     A report, not a gate: mutation testing judges the tests, coverage shows what no test runs. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Bruinet.*]*</Include>
          <Exclude>[*.Tests]*,[*.TestHost]*,[*.TestSite]*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
